# --- Приложение ---
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://booking:booking@db:5432/booking
LOG_LEVEL=INFO
JWT_SECRET=change-me
WEBHOOK_SECRET=webhook-change-me
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14
RESERVATION_TTL_MIN=15

# --- PostgreSQL (используется docker-compose) ---
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking
POSTGRES_PORT=5432

# --- Порты сервисов ---
API_PORT=8000
